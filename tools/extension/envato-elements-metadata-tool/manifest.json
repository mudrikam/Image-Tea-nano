{
  "manifest_version": 3,
  "name": "Envato Elements Mockup Metadata Tool",
  "version": "1.0.0",
  "description": "Paste Envato mockup metadata and fill the submission form with human-like interactions.",
  "permissions": ["activeTab", "tabs", "scripting", "clipboardRead", "storage", "sidePanel"],
  "host_permissions": [
    "https://elements.envato.com/*",
    "https://elements-contributors.envato.com/*"
  ],
  "action": {
    "default_title": "Envato Elements Mockup Metadata Tool",
    "default_icon": {
      "16": "icons/envato-16.png",
      "48": "icons/envato-48.png",
      "128": "icons/envato-128.png"
    }
  },
  "icons": {
    "16": "icons/envato-16.png",
    "48": "icons/envato-48.png",
    "128": "icons/envato-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://elements.envato.com/*",
        "https://elements-contributors.envato.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
