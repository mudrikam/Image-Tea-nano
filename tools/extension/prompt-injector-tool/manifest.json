{
  "manifest_version": 3,
  "name": "Desainia Prompt Injector Tool",
  "version": "1.0.0",
  "icons": {
    "16": "icons/logo_16.png",
    "32": "icons/logo_32.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png",
    "256": "icons/logo_256.png"
  },
  "description": "Automate prompt injection across websites using element selectors",
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "scripting",
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Open Desainia Prompt Injector",
    "default_icon": {
      "16": "icons/logo_16.png",
      "32": "icons/logo_32.png",
      "48": "icons/logo_48.png",
      "128": "icons/logo_128.png",
      "256": "icons/logo_256.png"
    }
  }
}
