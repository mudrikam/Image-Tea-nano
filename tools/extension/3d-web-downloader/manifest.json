{
  "manifest_version": 3,
  "name": "3D Web Downloader",
  "version": "1.0.0",
  "description": "Detect, preview, and download GLB, glTF, and USDZ assets from the current web page.",
  "icons": {
    "16": "icons/logo_16.png",
    "32": "icons/logo_32.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "downloads",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Open 3D Web Downloader",
    "default_icon": {
      "16": "icons/logo_16.png",
      "32": "icons/logo_32.png",
      "48": "icons/logo_48.png",
      "128": "icons/logo_128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/three.module.js",
        "vendor/GLTFLoader.js",
        "vendor/OrbitControls.js",
        "vendor/RoomEnvironment.js",
        "vendor/DRACOLoader.js",
        "vendor/utils/BufferGeometryUtils.js",
        "vendor/draco/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
