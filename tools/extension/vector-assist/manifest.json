{
  "manifest_version": 3,
  "name": "Vector Assist",
  "version": "1.2.0",
  "description": "Automates Vectorizer assistance for batch vectorization",
  "icons": {
    "16": "icons/logo_16.png",
    "32": "icons/logo_32.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://vectorizer.ai/*",
    "*://*.vectorizer.ai/*"
  ],
  "action": {
    "default_title": "Open Vector Assist",
    "default_icon": {
      "16": "icons/logo_16.png",
      "32": "icons/logo_32.png",
      "48": "icons/logo_48.png",
      "128": "icons/logo_128.png",
      "256": "icons/logo_256.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://vectorizer.ai/*",
        "*://*.vectorizer.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
