{
  "manifest_version": 3,
  "name": "Vector Assist",
  "version": "0.1.0",
  "description": "Vector Assist — side panel assistant (UI only).",
  "icons": {
    "16": "icons/logo_16.png",
    "32": "icons/logo_32.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.vectorizer.ai/*",
    "https://vectorizer.ai/*"
  ],
  "action": {
    "default_title": "Open Vector Assist",
    "default_icon": {
      "16": "icons/logo_16.png",
      "32": "icons/logo_32.png",
      "48": "icons/logo_48.png",
      "128": "icons/logo_128.png",
      "256": "icons/logo_256.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
