{
  "manifest_version": 3,
  "name": "Vees Downloader",
  "version": "0.1.0",
  "description": "Batch vectorizer for vectorizer.studio — drag & drop images, auto-detect blobs, download SVG.",
  "icons": {
    "16": "icons/logo_16.png",
    "32": "icons/logo_32.png",
    "48": "icons/logo_48.png",
    "128": "icons/logo_128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.vectorizer.studio/*",
    "https://vectorizer.studio/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.vectorizer.studio/*", "https://vectorizer.studio/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Open Vees Downloader",
    "default_icon": {
      "16": "icons/logo_16.png",
      "32": "icons/logo_32.png",
      "48": "icons/logo_48.png",
      "128": "icons/logo_128.png",
      "256": "icons/logo_256.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
