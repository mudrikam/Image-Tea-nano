  "prompt_generator": {
    "instructions": {
      "image_generation": "Analyze this image and generate creative, detailed prompts for AI image generation. Create unique variations based on visual content, including subject, setting, mood, style, and observed details. Ensure diverse themes without repetition. Focus on prompts that would generate similar or related images.",
      "video_generation": "Analyze this image and generate creative, detailed prompts for AI video generation. Create dynamic variations that describe motion, transitions, camera movements, and temporal elements. Focus on how the scene could evolve over time, including potential actions, movements, atmospheric changes, and cinematic techniques."
    },
    "requirements": {
      "image_generation": [
        "Each prompt should be approximately {prompt_length} characters long",
        "Generate exactly {prompts_per_file} unique, detailed prompts",
        "Prompts must be unique and detailed, based on visual content",
        "Specify subject, setting, mood, style, and relevant details",
        "Include aspect ratio specification: {aspect_ratio}",
        "Ensure wide range of variations inspired by image content",
        "Variation level: {variation_level}/10 - {variation_description}",
        "Apply variation level to angle, lighting, background, atmosphere, and visual composition\u2014not artistic style",
        "Avoid repetition between prompts - each must be distinctly different",
        "Focus on creating prompts for similar or related images",
        "STRICTLY FORBIDDEN: Never start a prompt with 'A ', 'An ', 'a ', or 'an '. Always use clear, direct words instead",
        "STRICTLY FORBIDDEN: Never include variation instructions, parameter names, or meta-text in the prompt output. Text like 'Different angle', 'Change lighting', 'Variation level', or 'light source changes' are YOUR instructions, NOT part of the prompt. Only output the final visual description",
        "Avoid adding commas to prompts",
        "Use \"by\" instead of colon when declaring aspect ratio e.g. \"4 by 3 aspect ratio\""
      ],
      "video_generation": [
        "Each prompt should be approximately {prompt_length} characters long",
        "Generate exactly {prompts_per_file} unique, detailed prompts",
        "Prompts must describe dynamic scenes with motion and temporal elements",
        "Include camera movements, transitions, and cinematic techniques",
        "Specify aspect ratio for video: {aspect_ratio}",
        "Describe how the scene evolves over time (3-10 seconds)",
        "Variation level: {variation_level}/10 - {variation_description}",
        "Apply variation to camera angle, atmosphere, lighting, background, and scene composition\u2014not artistic style",
        "Include atmospheric changes, lighting transitions, or character actions",
        "Focus on creating engaging video sequences based on the image content",
        "STRICTLY FORBIDDEN: Never start a prompt with 'A ', 'An ', 'a ', or 'an '. Always use clear, direct words instead",
        "STRICTLY FORBIDDEN: Never include variation instructions, parameter names, or meta-text in the prompt output. Text like 'Different angle', 'Change lighting', 'Variation level', or 'light source changes' are YOUR instructions, NOT part of the prompt. Only output the final visual description",
        "Avoid adding commas to prompts",
        "Use \"by\" instead of colon when declaring aspect ratio e.g. \"4 by 3 aspect ratio\""
      ]
    },
    "response_format": {
      "type": "json",
      "structure": {
        "prompts": [
          "prompt 1 text here...",
          "prompt 2 text here..."
        ]
      },
      "validation_rules": [
        "Return exactly {prompts_per_file} prompts in array",
        "Each prompt should be around {prompt_length} characters",
        "Use double quotes for all strings",
        "Response must be valid JSON",
        "NO explanation, markdown, or extra text",
        "Base all prompts on visual content of image",
        "Include aspect ratio in each prompt: {aspect_ratio}",
        "Consider metadata context if provided, but prioritize visual analysis"
      ]
    },
