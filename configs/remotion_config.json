{
    "version": "latest",
    "bundle_name": "remotion-bundle",
    "auto_install": true,
    "npm_registry": "https://registry.npmjs.org",
    "npm_strict_ssl": true,
    "render_settings": {
        "codec": "h264",
        "pixel_format": "yuv420p",
        "crf": 18,
        "frames_per_lambda": 1
    },
    "environment": {
        "NODE_ENV": "production"
    },
    "max_old_space_size": 4096,
    "concurrency": 4,
    "offthreadvideo_cache_size_in_bytes": null,
    "active_preset": "1080p60",
    "presets": {
        "720p30": {
            "label": "Horizontal HD 720p (16:9)",
            "width": 1280,
            "height": 720,
            "fps": 30,
            "video_bitrate": "5M"
        },
        "1080p30": {
            "label": "Horizontal Full HD 1080p (16:9)",
            "width": 1920,
            "height": 1080,
            "fps": 30,
            "video_bitrate": "10M"
        },
        "1080p60": {
            "label": "Horizontal Full HD 1080p 60fps (16:9)",
            "width": 1920,
            "height": 1080,
            "fps": 60,
            "video_bitrate": "20M"
        },
        "2K30": {
            "label": "Horizontal 2K QHD (16:9)",
            "width": 2560,
            "height": 1440,
            "fps": 30,
            "video_bitrate": "20M"
        },
        "2K60": {
            "label": "Horizontal 2K QHD 60fps (16:9)",
            "width": 2560,
            "height": 1440,
            "fps": 60,
            "video_bitrate": "40M"
        },
        "4K30": {
            "label": "Horizontal 4K UHD (16:9)",
            "width": 3840,
            "height": 2160,
            "fps": 30,
            "video_bitrate": "40M"
        },
        "4K60": {
            "label": "Horizontal 4K UHD 60fps (16:9)",
            "width": 3840,
            "height": 2160,
            "fps": 60,
            "video_bitrate": "80M"
        },
        "square_720": {
            "label": "Square HD 720\u00d7720 (1:1)",
            "width": 720,
            "height": 720,
            "fps": 30,
            "video_bitrate": "5M"
        },
        "square_1080": {
            "label": "Square Full HD 1080\u00d71080 (1:1)",
            "width": 1080,
            "height": 1080,
            "fps": 30,
            "video_bitrate": "10M"
        },
        "square_1440": {
