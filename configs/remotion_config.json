            "video_bitrate": "5M"
        },
        "vertical_1080": {
            "label": "Vertical Full HD 1080\u00d71920 (9:16)",
            "width": 1080,
            "height": 1920,
            "fps": 30,
            "video_bitrate": "10M"
        },
        "vertical_1440": {
            "label": "Vertical 2K 1440\u00d72560 (9:16)",
            "width": 1440,
            "height": 2560,
            "fps": 30,
            "video_bitrate": "20M"
        },
        "ultrawide_1080": {
            "label": "Ultrawide Full HD 2560\u00d71080 (21:9)",
            "width": 2560,
